# API key de Anthropic para el chatbot de /api/chat. Obtenla en https://console.anthropic.com
# Cópiala a .env.local (que está en .gitignore). El chatbot es opcional: si no está,
# el route /api/chat responde con un error controlado y el buscador clásico sigue funcionando.
ANTHROPIC_API_KEY=

# API key de Resend para el formulario de contacto (/api/contact -> damecorreospapa@gmail.com).
# Obtenla en https://resend.com (3000 envíos/mes gratis). Opcional: sin esta key el
# formulario responde con un error controlado y el resto de la web sigue funcionando.
RESEND_API_KEY=

# (Opcional) Remitente del formulario de contacto. Por defecto usa el sandbox de
# Resend "Buscador de Médicos <onboarding@resend.dev>", que solo permite enviar al
# email dueño de la cuenta. Para producción verifica un dominio en Resend y pon
# aquí algo como: "Buscador de Médicos <hola@tudominio.com>".
CONTACT_FROM_EMAIL=

# ─────────────────────────────────────────────────────────────────────────────
# Secrets de las fuentes LIVE (lib/sources/*). Cada cliente está diseñado para
# NO lanzar: si su variable falta, devuelve [] en silencio y esa mutua deja de
# dar resultados sin romper el resto del buscador. Por eso conviene tenerlas
# documentadas: sin ellas, varias mutuas que la UI lista como operativas
# aparecen vacías. Se obtienen inspeccionando el "cuadro médico" público de cada
# aseguradora con chrome-devtools (ver "Methodology — adding a new mutua" en
# CLAUDE.md). Todas son OPCIONALES.

# Hash público que identifica la red Allianz en la plataforma Asisa
# (buscador.allianzsalud.es). Sin ella, searchAllianz() devuelve [].
ALLIANZ_HASH=

# Portlet ID del cuadro médico público de AXA Salud.
# Sin ella, searchAxa() devuelve [].
AXA_PORTLET_ID=

# API key del buscador público de Sanitas (sanitas.es). Sin ella, searchSanitas()
# devuelve [] — y con ella cae también Generali (searchGenerali delega en Sanitas).
SANITAS_APIKEY=

# Bearer token del buscador público de Adeslas usado por la ruta LIVE
# (lib/sources/adeslas-live.ts), que hoy solo consume MUFACE. NB: el dataset
# principal de Adeslas es OFFLINE (data/doctors.json) y no necesita esto.
# Sin el token, searchAdeslasLive() devuelve [] y MUFACE no da resultados.
ADESLAS_BEARER=
